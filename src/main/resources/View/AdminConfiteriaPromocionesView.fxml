<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="1060.0" spacing="16.0" styleClass="app-canvas"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.controller.AdminConfiteriaPromocionesController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
    </padding>

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Confitería, Combos y Promociones"/>
        <Label styleClass="text-muted" text="Configura productos individuales, arma combos compuestos y publica promociones vigentes"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Productos y Combos">
            <HBox spacing="16.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>

                <VBox prefWidth="285.0" spacing="10.0" styleClass="card">
                    <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/></padding>
                    <Label styleClass="section-title" text="Nuevo Producto"/>
                    <TextField fx:id="txtProdCodigo" promptText="Código (Ej: C006)"/>
                    <TextField fx:id="txtProdNombre" promptText="Nombre"/>
                    <TextField fx:id="txtProdPrecio" promptText="Precio ($)"/>
                    <TextField fx:id="txtProdPuntos" promptText="Puntos para redimir"/>
                    <Button maxWidth="Infinity" onAction="#onRegistrarProductoSimple"
                            styleClass="btn-primary" text="Guardar Producto"/>

                    <Separator/>
                    <Label styleClass="section-title" text="Armar Combo"/>
                    <TextField fx:id="txtComboCodigo" promptText="Código Combo (Ej: K003)"/>
                    <TextField fx:id="txtComboNombre" promptText="Nombre del Combo"/>
                    <HBox spacing="8.0">
                        <TextField fx:id="txtComboDescuento" promptText="Desc. %"/>
                        <TextField fx:id="txtComboPuntos" promptText="Puntos"/>
                    </HBox>
                    <HBox spacing="8.0">
                        <ComboBox fx:id="cmbItemParaCombo" maxWidth="Infinity" promptText="Elegir ítem..." HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onAgregarItemACombo" text="+"/>
                    </HBox>
                    <ListView fx:id="lstItemsDelCombo" prefHeight="85.0"/>
                    <Button maxWidth="Infinity" onAction="#onRegistrarCombo"
                            styleClass="btn-gold" text="Crear Combo"/>
                </VBox>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Catálogo Actual de Confitería"/>
                    <TableView fx:id="tblAdminConfiteria" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAdmItemCod" maxWidth="95.0" minWidth="75.0" text="Código"/>
                            <TableColumn fx:id="colAdmItemNom" prefWidth="240.0" text="Nombre"/>
                            <TableColumn fx:id="colAdmItemPre" prefWidth="120.0" text="Precio"/>
                            <TableColumn fx:id="colAdmItemPts" prefWidth="120.0" text="Puntos Redención"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Promociones">
            <HBox spacing="18.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>

                <VBox prefWidth="330.0" spacing="10.0" styleClass="card">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Registrar Promoción"/>
                    <TextField fx:id="txtPromoNombre" promptText="Nombre de la promoción"/>
                    <ComboBox fx:id="cmbTipoPromocion" maxWidth="Infinity" promptText="Tipo de Promoción"/>
                    <TextField fx:id="txtPromoValor" promptText="Valor (% o $ fijo)"/>
                    <ComboBox fx:id="cmbPromoDiaSemana" maxWidth="Infinity" promptText="Día especial (opcional)"/>
                    <DatePicker fx:id="dpPromoInicio" maxWidth="Infinity" promptText="Fecha Inicio"/>
                    <DatePicker fx:id="dpPromoFin" maxWidth="Infinity" promptText="Fecha Fin"/>
                    <Button maxWidth="Infinity" onAction="#onRegistrarPromocion"
                            styleClass="btn-primary" text="Publicar Promoción"/>
                </VBox>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Promociones Configuradas"/>
                    <TableView fx:id="tblAdminPromociones" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colPromoNombre" prefWidth="190.0" text="Nombre"/>
                            <TableColumn fx:id="colPromoTipo" prefWidth="120.0" text="Tipo"/>
                            <TableColumn fx:id="colPromoValor" prefWidth="100.0" text="Descuento"/>
                            <TableColumn fx:id="colPromoDia" prefWidth="110.0" text="Día"/>
                            <TableColumn fx:id="colPromoVigencia" prefWidth="180.0" text="Vigencia"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

    </TabPane>
</VBox>