<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="690.0" prefWidth="1080.0" styleClass="app-canvas"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.poo.controller.LoginRegistroController">

    <left>
        <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="20.0" styleClass="brand-panel">
            <padding>
                <Insets bottom="48.0" left="44.0" right="44.0" top="48.0"/>
            </padding>
            <Label styleClass="brand-kicker" text="EXPERIENCIA DE SALA · ARMENIA"/>
            <HBox alignment="CENTER_LEFT" spacing="2.0">
                <Label styleClass="brand-logo" text="Cinema"/>
                <Label styleClass="brand-logo-accent" text="UQ"/>
            </HBox>
            <Separator/>
            <Label styleClass="section-title" text="Taquilla digital, confitería y gestión operativa."/>
            <Label styleClass="text-muted" wrapText="true"
                   text="Reserva asientos en tiempo real, acumula puntos por cada función, redime combos y administra salas desde una única plataforma."/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="6.0" styleClass="sub-panel">
                <padding>
                    <Insets bottom="12.0" left="14.0" right="14.0" top="12.0"/>
                </padding>
                <Label styleClass="field-label" text="ACCESOS RÁPIDOS DE PRUEBA"/>
                <Label styleClass="text-muted" text="Cliente: juan@correo.com  ·  1234"/>
                <Label styleClass="text-muted" text="Admin: admin@cinemauq.com  ·  admin123"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="app-canvas">
            <padding>
                <Insets bottom="36.0" left="54.0" right="54.0" top="36.0"/>
            </padding>
            <VBox styleClass="card" maxWidth="540.0">
                <padding>
                    <Insets bottom="26.0" left="30.0" right="30.0" top="22.0"/>
                </padding>
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                    <Tab text="Iniciar Sesión">
                        <VBox alignment="CENTER_LEFT" spacing="16.0">
                            <padding>
                                <Insets bottom="12.0" left="4.0" right="4.0" top="22.0"/>
                            </padding>
                            <VBox spacing="4.0">
                                <Label styleClass="page-title" text="Bienvenido de nuevo"/>
                                <Label styleClass="text-muted" text="Ingresa tus credenciales de Cliente o Administrador"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label styleClass="field-label" text="CORREO ELECTRÓNICO"/>
                                <TextField fx:id="txtLoginCorreo" promptText="usuario@uniquindio.edu.co"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label styleClass="field-label" text="CONTRASEÑA"/>
                                <PasswordField fx:id="txtLoginContrasena" promptText="••••••••"/>
                            </VBox>

                            <Label fx:id="lblMensajeLogin" styleClass="status-feedback" text="" wrapText="true"/>

                            <Button fx:id="btnIniciarSesion" maxWidth="Infinity" onAction="#onIniciarSesion"
                                    styleClass="btn-primary" text="Ingresar a CinemaUQ"/>
                        </VBox>
                    </Tab>

                    <Tab text="Crear Cuenta">
                        <VBox alignment="CENTER_LEFT" spacing="13.0">
                            <padding>
                                <Insets bottom="8.0" left="4.0" right="4.0" top="18.0"/>
                            </padding>
                            <VBox spacing="3.0">
                                <Label styleClass="section-title" text="Registro de Usuario"/>
                                <Label styleClass="text-muted" text="Selecciona el perfil e ingresa los datos requeridos"/>
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="sub-panel">
                                <padding>
                                    <Insets bottom="8.0" left="12.0" right="12.0" top="8.0"/>
                                </padding>
                                <Label styleClass="field-label" text="PERFIL:"/>
                                <ComboBox fx:id="cmbTipoPersonaRegistro" onAction="#onCambiarTipoPersona"
                                          prefWidth="240.0" promptText="Seleccionar rol"/>
                            </HBox>

                            <GridPane hgap="14.0" vgap="10.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0"/>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0"/>
                                </columnConstraints>

                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="IDENTIFICACIÓN (ID)"/>
                                    <TextField fx:id="txtRegistroId" promptText="Documento"/>
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label styleClass="field-label" text="NOMBRE COMPLETO"/>
                                    <TextField fx:id="txtRegistroNombre" promptText="Nombre y apellidos"/>
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label styleClass="field-label" text="CORREO ELECTRÓNICO"/>
                                    <TextField fx:id="txtRegistroCorreo" promptText="correo@dominio.com"/>
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label styleClass="field-label" text="TELÉFONO (CLIENTE)"/>
                                    <TextField fx:id="txtRegistroTelefono" promptText="300 000 0000"/>
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label styleClass="field-label" text="CARGO (ADMINISTRADOR)"/>
                                    <TextField fx:id="txtRegistroCargoAdmin" promptText="Ej: Gerente Operativo"/>
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label styleClass="field-label" text="CONTRASEÑA"/>
                                    <PasswordField fx:id="txtRegistroContrasena" promptText="Contraseña segura"/>
                                </VBox>
                            </GridPane>

                            <Label fx:id="lblMensajeRegistro" styleClass="status-feedback" text="" wrapText="true"/>

                            <Button fx:id="btnRegistrarPersona" maxWidth="Infinity" onAction="#onRegistrarPersona"
                                    styleClass="btn-gold" text="Registrar en CinemaUQ"/>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>