<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="adminMainBorderPane" prefHeight="780.0" prefWidth="1320.0" styleClass="app-canvas"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.poo.controller.AdminDashboardReportesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar">
            <padding><Insets bottom="12.0" left="24.0" right="24.0" top="12.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="2.0">
                <Label styleClass="cinema-title" text="Cinema"/>
                <Label style="-fx-text-fill: #E11D48; -fx-font-size: 18px; -fx-font-weight: bold;" text="UQ"/>
            </HBox>
            <Label styleClass="pill-crimson" text="CONSOLA ADMIN"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblAdminActivo" styleClass="section-title" text="Administrador"/>
            <Button onAction="#onCerrarSesionAdmin" styleClass="btn-danger" text="Cerrar Sesión"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="230.0" spacing="6.0" styleClass="sidebar">
            <padding><Insets bottom="20.0" left="14.0" right="14.0" top="20.0"/></padding>
            <Label styleClass="kpi-label" text="OPERACIONES">
                <padding><Insets bottom="6.0" left="10.0"/></padding>
            </Label>
            <Button maxWidth="Infinity" onAction="#onMostrarDashboardReportes"
                    styleClass="nav-btn" text="Analítica y Reportes"/>
            <Button maxWidth="Infinity" onAction="#onMostrarGestionCartelera"
                    styleClass="nav-btn" text="Películas, Salas y Funciones"/>
            <Button maxWidth="Infinity" onAction="#onMostrarGestionConfiteria"
                    styleClass="nav-btn" text="Confitería y Promociones"/>
            <Button maxWidth="Infinity" onAction="#onMostrarGestionClientesRecargas"
                    styleClass="nav-btn" text="Recargas y Clientes"/>
            <Button maxWidth="Infinity" onAction="#onMostrarRegistroUsuarios"
                    styleClass="nav-btn" text="Directorio de Usuarios"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16.0" styleClass="app-canvas">
                <padding><Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0">
                        <Label styleClass="page-title" text="Analítica Operativa y Reportes"/>
                        <Label styleClass="text-muted" text="Métricas de taquilla, ocupación de salas y generación de reportes exportables"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="cmbTipoReporte" prefWidth="165.0" promptText="Tipo de Reporte"/>
                    <DatePicker fx:id="dpFechaInicio" prefWidth="135.0" promptText="Inicio"/>
                    <DatePicker fx:id="dpFechaFin" prefWidth="135.0" promptText="Fin"/>
                    <Button onAction="#onGenerarReporte" styleClass="btn-primary" text="Generar Reporte"/>
                </HBox>

                <HBox spacing="14.0">
                    <VBox spacing="4.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0"/></padding>
                        <Label styleClass="kpi-label" text="ENTRADAS VENDIDAS"/>
                        <Label fx:id="lblKpiEntradas" styleClass="kpi-value" text="0"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0"/></padding>
                        <Label styleClass="kpi-label" text="INGRESOS BRUTOS"/>
                        <Label fx:id="lblKpiIngresos" styleClass="kpi-value-gold" text="\$ 0"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0"/></padding>
                        <Label styleClass="kpi-label" text="OCUPACIÓN PROMEDIO"/>
                        <Label fx:id="lblKpiOcupacion" styleClass="kpi-value" text="0.0 %"/>
                    </VBox>
                    <VBox spacing="4.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0"/></padding>
                        <Label styleClass="kpi-label" text="REEMBOLSOS"/>
                        <Label fx:id="lblKpiReembolsos" styleClass="kpi-value-crimson" text="0"/>
                    </VBox>
                </HBox>

                <HBox prefHeight="250.0" spacing="14.0">
                    <VBox spacing="6.0" styleClass="card" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="10.0" left="12.0" right="12.0" top="12.0"/></padding>
                        <Label styleClass="section-title" text="Ingresos por Película / Confitería"/>
                        <BarChart fx:id="barChartVentasPelicula" legendVisible="false" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                            <yAxis><NumberAxis side="LEFT"/></yAxis>
                        </BarChart>
                    </VBox>

                    <VBox prefWidth="310.0" spacing="6.0" styleClass="card">
                        <padding><Insets bottom="10.0" left="12.0" right="12.0" top="12.0"/></padding>
                        <Label styleClass="section-title" text="Ocupación por Sala"/>
                        <PieChart fx:id="pieChartOcupacionSalas" labelsVisible="false" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox spacing="6.0" styleClass="card" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="10.0" left="12.0" right="12.0" top="12.0"/></padding>
                        <Label styleClass="section-title" text="Ventas vs. Recargas en el Tiempo"/>
                        <LineChart fx:id="lineChartComportamientoTiempo" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                            <yAxis><NumberAxis side="LEFT"/></yAxis>
                        </LineChart>
                    </VBox>
                </HBox>

                <VBox spacing="10.0" styleClass="card">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                        <Label fx:id="lblTituloReporteGenerado" styleClass="section-title" text="Vista Previa del Reporte"/>
                        <Label fx:id="lblFechaGeneracionReporte" styleClass="text-muted" text=""/>
                        <Label fx:id="lblTotalRegistrosReporte" styleClass="pill-gold" text="0 registros"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onExportarTxt" text="Exportar TXT"/>
                        <Button onAction="#onExportarPdf" styleClass="btn-gold" text="Exportar PDF"/>
                    </HBox>
                    <TextArea fx:id="txtVistaPreviaReporte" editable="false" prefHeight="190.0"
                              promptText="Selecciona un tipo de reporte y haz clic en Generar Reporte..."
                              style="-fx-font-family: 'Consolas', 'JetBrains Mono', monospace; -fx-font-size: 12px;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>