<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="740.0" prefWidth="1220.0" styleClass="app-canvas"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.poo.controller.SeleccionAsientosController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="card">
            <BorderPane.margin>
                <Insets bottom="6.0" left="24.0" right="24.0" top="16.0"/>
            </BorderPane.margin>
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0"/>
            </padding>
            <Label styleClass="pill-crimson" text="SALA EN VIVO"/>
            <Label fx:id="lblHeaderPelicula" styleClass="cinema-title" text="Horizonte Perdido"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblHeaderFecha" styleClass="value-text" text="22/11/2026"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblHeaderHora" styleClass="value-text" text="07:15 PM"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblHeaderSala" styleClass="pill-gold" text="Sala 2"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="card">
            <BorderPane.margin>
                <Insets bottom="20.0" left="24.0" right="14.0" top="10.0"/>
            </BorderPane.margin>
            <padding>
                <Insets bottom="22.0" left="26.0" right="26.0" top="22.0"/>
            </padding>

            <VBox alignment="CENTER" spacing="6.0">
                <Label styleClass="kpi-label" text="P A N T A L L A"/>
                <Region maxWidth="540.0" prefHeight="10.0" styleClass="cinema-screen"/>
            </VBox>

            <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                <StackPane style="-fx-background-color: #0B0B0E;">
                    <GridPane fx:id="gridMapaAsientos" alignment="CENTER" hgap="9.0" vgap="9.0">
                        <padding>
                            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                        </padding>
                    </GridPane>
                </StackPane>
            </ScrollPane>

            <HBox alignment="CENTER" spacing="24.0">
                <HBox alignment="CENTER" spacing="7.0">
                    <Region prefHeight="16.0" prefWidth="16.0" styleClass="seat-btn, seat-available"/>
                    <Label styleClass="text-muted" text="Disponible"/>
                </HBox>
                <HBox alignment="CENTER" spacing="7.0">
                    <Region prefHeight="16.0" prefWidth="16.0" styleClass="seat-btn, seat-preferencial"/>
                    <Label styleClass="text-muted" text="Preferencial"/>
                </HBox>
                <HBox alignment="CENTER" spacing="7.0">
                    <Region prefHeight="16.0" prefWidth="16.0" styleClass="seat-btn, seat-accessible"/>
                    <Label styleClass="text-muted" text="Accesible"/>
                </HBox>
                <HBox alignment="CENTER" spacing="7.0">
                    <Region prefHeight="16.0" prefWidth="16.0" styleClass="seat-btn, seat-selected"/>
                    <Label styleClass="text-muted" text="Seleccionado"/>
                </HBox>
                <HBox alignment="CENTER" spacing="7.0">
                    <Region prefHeight="16.0" prefWidth="16.0" styleClass="seat-btn, seat-occupied"/>
                    <Label styleClass="text-muted" text="Ocupado"/>
                </HBox>
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="350.0" spacing="14.0" styleClass="card-elevated">
            <BorderPane.margin>
                <Insets bottom="20.0" left="4.0" right="24.0" top="10.0"/>
            </BorderPane.margin>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <VBox spacing="3.0">
                <Label fx:id="lblSideTituloPelicula" styleClass="cinema-title" text="Horizonte Perdido"/>
                <Label fx:id="lblSideDetallesFuncion" styleClass="text-muted" text="Sala 2 · 07:15 PM"/>
            </VBox>
            <Separator/>

            <Label styleClass="kpi-label" text="ASIENTOS SELECCIONADOS"/>
            <FlowPane fx:id="flowAsientosSeleccionados" hgap="7.0" minHeight="54.0" prefWrapLength="300.0"
                      styleClass="sub-panel" vgap="7.0">
                <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
            </FlowPane>

            <Separator/>
            <Label styleClass="kpi-label" text="DETALLE DE BOLETAS"/>

            <GridPane hgap="10.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT"/>
                </columnConstraints>
                <Label styleClass="text-muted" text="Cantidad de Boletas:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblCantidadBoletas" styleClass="value-text" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label styleClass="text-muted" text="Precio Unitario:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblPrecioUnitario" styleClass="value-text" text="\$ 0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label styleClass="section-title" text="Subtotal Entradas:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="lblSubtotalEntradas" styleClass="total-highlight" text="\$ 0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sub-panel">
                <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0"/></padding>
                <VBox HBox.hgrow="ALWAYS">
                    <Label styleClass="brand-kicker" text="PUNTOS ESTIMADOS"/>
                    <Label styleClass="text-muted" text="Se acreditan al pagar"/>
                </VBox>
                <Label fx:id="lblPuntosEstimados" styleClass="pill-gold" text="0 pts"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnIrCompraConfiteria" maxWidth="Infinity" onAction="#onIrACompraConfiteria"
                    text="Agregar Confitería y Combos"/>
            <Button fx:id="btnContinuarPago" maxWidth="Infinity" onAction="#onContinuarAlPago"
                    styleClass="btn-gold" text="Continuar al Resumen y Pago"/>
            <Button fx:id="btnVolverCartelera" maxWidth="Infinity" onAction="#onVolverACartelera"
                    styleClass="btn-ghost" text="Volver a Cartelera"/>
        </VBox>
    </right>
</BorderPane>