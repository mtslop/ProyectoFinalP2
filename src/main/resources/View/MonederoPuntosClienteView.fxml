<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="680.0" prefWidth="1040.0" spacing="16.0" styleClass="app-canvas"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.controller.MonederoPuntosClienteController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
    </padding>

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Monedero Virtual y Puntos"/>
        <Label styleClass="text-muted" text="Solicita recargas de saldo, audita tus movimientos y consulta la vigencia de tus puntos"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Tarjeta Virtual y Movimientos">
            <HBox spacing="18.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>

                <VBox prefWidth="340.0" spacing="12.0" styleClass="card">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Solicitar Recarga"/>
                    <Label styleClass="text-muted" wrapText="true"
                           text="Crea una solicitud de recarga que será aprobada por el administrador."/>

                    <VBox spacing="5.0">
                        <Label styleClass="field-label" text="MONTO A RECARGAR ($)"/>
                        <TextField fx:id="txtMontoSolicitudRecarga" promptText="Ej: 50000"/>
                    </VBox>

                    <Button fx:id="btnEnviarSolicitudRecarga" maxWidth="Infinity" onAction="#onSolicitarRecarga"
                            styleClass="btn-primary" text="Enviar Solicitud"/>

                    <Separator/>
                    <Label styleClass="field-label" text="MIS SOLICITUDES"/>
                    <TableView fx:id="tblMisSolicitudesRecarga" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colSolId" prefWidth="70.0" text="ID"/>
                            <TableColumn fx:id="colSolMonto" prefWidth="95.0" text="Monto"/>
                            <TableColumn fx:id="colSolEstado" prefWidth="110.0" text="Estado"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="section-title" text="Historial de Movimientos"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblResumenTarjetaNumero" styleClass="pill-emerald" text="Numero Tarjeta: ---"/>
                    </HBox>
                    <TableView fx:id="tblMovimientosTarjeta" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colMovId" prefWidth="85.0" text="ID"/>
                            <TableColumn fx:id="colMovFecha" prefWidth="140.0" text="Fecha"/>
                            <TableColumn fx:id="colMovTipo" prefWidth="110.0" text="Tipo"/>
                            <TableColumn fx:id="colMovValor" prefWidth="105.0" text="Valor"/>
                            <TableColumn fx:id="colMovDescripcion" prefWidth="210.0" text="Descripción"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Cuenta de Puntos y Vigencia">
            <VBox spacing="14.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="card">
                    <padding><Insets bottom="14.0" left="20.0" right="20.0" top="14.0"/></padding>
                    <VBox spacing="2.0">
                        <Label styleClass="kpi-label" text="PUNTOS DISPONIBLES"/>
                        <Label fx:id="lblTotalPuntosDisponibles" styleClass="kpi-value-gold" text="0 pts"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox spacing="2.0">
                        <Label styleClass="kpi-label" text="ESTRATEGIA ACTIVA"/>
                        <Label fx:id="lblEstrategiaActiva" styleClass="section-title" text="EstrategiaPuntosEstandar"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnDepurarPuntosVencidos" onAction="#onEliminarPuntosVencidos"
                            styleClass="btn-danger" text="Depurar Puntos Vencidos"/>
                </HBox>

                <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Lotes de Puntos (Vigencia de 1 Año)"/>
                    <TableView fx:id="tblRegistrosPuntos" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colRegCantidadInicial" prefWidth="150.0" text="Obtenidos"/>
                            <TableColumn fx:id="colRegCantidadDisponible" prefWidth="150.0" text="Disponibles"/>
                            <TableColumn fx:id="colRegFechaObtencion" prefWidth="160.0" text="Obtención"/>
                            <TableColumn fx:id="colRegFechaVencimiento" prefWidth="160.0" text="Vencimiento"/>
                            <TableColumn fx:id="colRegEstadoVencido" prefWidth="130.0" text="Estado"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>

    </TabPane>
</VBox>