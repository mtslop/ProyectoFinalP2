<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="1060.0" spacing="16.0" styleClass="app-canvas"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.controller.AdminRegistroUsuariosController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
    </padding>

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Directorio y Registro de Usuarios"/>
        <Label styleClass="text-muted" text="Crea cuentas de clientes o administradores y consulta el directorio del sistema"/>
    </VBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="340.0" spacing="10.0" styleClass="card">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
            <Label styleClass="section-title" text="Registrar Nueva Persona"/>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="ROL DEL USUARIO"/>
                <ComboBox fx:id="cmbAdminTipoUsuario" maxWidth="Infinity" onAction="#onSeleccionarTipoUsuario"/>
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="IDENTIFICACIÓN"/>
                <TextField fx:id="txtUsuId" promptText="Documento"/>
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="NOMBRE COMPLETO"/>
                <TextField fx:id="txtUsuNombre" promptText="Nombre y apellidos"/>
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="CORREO ELECTRÓNICO"/>
                <TextField fx:id="txtUsuCorreo" promptText="correo@cinemauq.com"/>
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="CONTRASEÑA"/>
                <PasswordField fx:id="txtUsuContrasena" promptText="Contraseña"/>
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="TELÉFONO (SI ES CLIENTE)"/>
                <TextField fx:id="txtUsuTelefonoCliente" promptText="Teléfono"/>
            </VBox>

            <VBox spacing="4.0">
                <Label styleClass="field-label" text="CARGO (SI ES ADMINISTRADOR)"/>
                <TextField fx:id="txtUsuCargoAdmin" promptText="Cargo administrativo"/>
            </VBox>

            <Button fx:id="btnGuardarNuevoUsuario" maxWidth="Infinity" onAction="#onRegistrarUsuarioDesdeAdmin"
                    styleClass="btn-primary" text="Registrar Usuario"/>
        </VBox>

        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
            <Label styleClass="section-title" text="Personas Registradas en CinemaUQ"/>
            <TableView fx:id="tblDirectorioPersonas" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colPerId" maxWidth="95.0" minWidth="75.0" text="ID"/>
                    <TableColumn fx:id="colPerNombre" prefWidth="170.0" text="Nombre"/>
                    <TableColumn fx:id="colPerCorreo" prefWidth="180.0" text="Correo"/>
                    <TableColumn fx:id="colPerRol" prefWidth="125.0" text="Rol"/>
                    <TableColumn fx:id="colPerDetalle" prefWidth="140.0" text="Teléfono / Cargo"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>