<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1180.0" styleClass="app-canvas"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.poo.controller.CompraConfiteriaController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <padding>
                <Insets bottom="6.0" left="24.0" right="24.0" top="20.0"/>
            </padding>
            <VBox spacing="2.0">
                <Label styleClass="page-title" text="Confitería y Combos"/>
                <Label styleClass="text-muted" text="Agrega productos individuales o combos a tu orden, o redímelos con puntos"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets bottom="22.0" left="24.0" right="24.0" top="12.0"/>
            </padding>

            <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                </padding>
                <Label styleClass="section-title" text="Catálogo Disponible"/>
                <TableView fx:id="tblCatalogoConfiteria" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colItemCodigo" maxWidth="85.0" minWidth="70.0" text="Código"/>
                        <TableColumn fx:id="colItemNombre" prefWidth="220.0" text="Producto / Combo"/>
                        <TableColumn fx:id="colItemTipo" prefWidth="105.0" text="Tipo"/>
                        <TableColumn fx:id="colItemPrecio" prefWidth="105.0" text="Precio"/>
                        <TableColumn fx:id="colItemPuntosRedencion" prefWidth="120.0" text="Redención"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <Label styleClass="field-label" text="CANTIDAD:"/>
                    <Spinner fx:id="spnCantidadItem" prefWidth="88.0"/>
                    <Button fx:id="btnAgregarACompra" onAction="#onAgregarItemCompra"
                            styleClass="btn-primary" text="Agregar a la Compra"/>
                    <Button fx:id="btnRedimirConPuntos" onAction="#onRedimirItemConPuntos"
                            text="Redimir con Puntos"/>
                </HBox>
            </VBox>

            <VBox prefWidth="440.0" spacing="12.0" styleClass="card-elevated">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                </padding>
                <Label styleClass="section-title" text="Tu Pedido de Confitería"/>
                <TableView fx:id="tblDetalleConfiteria" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colDetItem" prefWidth="175.0" text="Ítem"/>
                        <TableColumn fx:id="colDetCant" maxWidth="65.0" minWidth="55.0" text="Cant."/>
                        <TableColumn fx:id="colDetUnitario" prefWidth="85.0" text="Unitario"/>
                        <TableColumn fx:id="colDetSubtotal" prefWidth="90.0" text="Subtotal"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button onAction="#onEliminarDetalle" styleClass="btn-ghost" text="Quitar"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="text-muted" text="Subtotal Confitería:"/>
                    <Label fx:id="lblTotalConfiteria" styleClass="total-highlight" text="\$ 0"/>
                </HBox>

                <Button fx:id="btnIrResumenPago" maxWidth="Infinity" onAction="#onIrACheckout"
                        styleClass="btn-gold" text="Ir al Resumen y Pago Final"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>