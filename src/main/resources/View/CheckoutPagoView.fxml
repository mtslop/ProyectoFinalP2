<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="1120.0" spacing="16.0" styleClass="app-canvas"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.controller.CheckoutPagoController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label styleClass="page-title" text="Resumen de Orden y Pago"/>
            <Label styleClass="text-muted" text="Verifica tus boletas, aplica promociones vigentes y confirma con tu tarjeta virtual"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblIdCompra" styleClass="pill-gold" text="CMP-0001"/>
        <Label fx:id="lblEstadoCompra" styleClass="pill-crimson" text="PENDIENTE"/>
    </HBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
            <padding><Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/></padding>
            <Label styleClass="section-title" text="Conceptos y Promociones"/>

            <GridPane hgap="12.0" vgap="8.0" styleClass="sub-panel">
                <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0"/></padding>
                <columnConstraints>
                    <ColumnConstraints minWidth="110.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label styleClass="field-label" text="FUNCIÓN:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblResumenFuncion" styleClass="value-text" text="---" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label styleClass="field-label" text="ASIENTOS:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblResumenAsientos" styleClass="value-text" text="Ninguno" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ComboBox fx:id="cmbPromocionesVigentes" maxWidth="Infinity" promptText="Seleccionar promoción vigente..." HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAplicarPromocion" onAction="#onAplicarPromocion" text="Aplicar Promoción"/>
                <Button fx:id="btnRedimirEntradaPuntos" onAction="#onRedimirEntrada" text="Redimir 1 Entrada (Pts)"/>
            </HBox>

            <Label styleClass="field-label" text="DESGLOSE DE LA ORDEN Y DESCUENTOS"/>
            <TextArea fx:id="txtDescripcionDecorador" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox prefWidth="390.0" spacing="14.0" styleClass="card-elevated">
            <padding><Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/></padding>
            <Label styleClass="section-title" text="Tarjeta Virtual CinemaUQ"/>

            <VBox spacing="8.0" styleClass="sub-panel">
                <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/></padding>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="kpi-label" text="TARJETA ASOCIADA"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEstadoTarjeta" styleClass="pill-emerald" text="ACTIVA"/>
                </HBox>
                <Label fx:id="lblNumeroTarjeta" styleClass="section-title" text="0000-0000"/>
                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="text-muted" text="Saldo Disponible:"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSaldoDisponiblePago" styleClass="value-text" text="\$ 0"/>
                </HBox>
            </VBox>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT"/>
                </columnConstraints>
                <Label styleClass="text-muted" text="Subtotal:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblSubtotalOrden" styleClass="value-text" text="\$ 0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label styleClass="text-muted" text="Puntos a ganar:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblPuntosAGanar" styleClass="pill-gold" text="0 pts" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label styleClass="section-title" text="Total a Pagar:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="lblTotalAPagar" styleClass="total-highlight" text="\$ 0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnPagarCompra" maxWidth="Infinity" onAction="#onPagarConTarjeta"
                    styleClass="btn-gold" text="Confirmar y Pagar Compra"/>
            <Button fx:id="btnSolicitarRecargaEmergencia" maxWidth="Infinity" onAction="#onIrASolicitarRecarga"
                    text="Recargar Saldo en Monedero"/>
            <Button fx:id="btnCancelarOrdenPendiente" maxWidth="Infinity" onAction="#onCancelarCompraPendiente"
                    styleClass="btn-danger" text="Cancelar Orden"/>
        </VBox>
    </HBox>
</VBox>