<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="1060.0" spacing="16.0" styleClass="app-canvas"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.controller.AdminCarteleraSalasController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
    </padding>

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Películas, Salas y Funciones"/>
        <Label styleClass="text-muted" text="Administra el catálogo de películas, configura salas y programa horarios sin solapamientos"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Películas">
            <HBox spacing="18.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>
                <VBox prefWidth="330.0" spacing="10.0" styleClass="card">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Nueva Película"/>
                    <TextField fx:id="txtPeliCodigo" promptText="Código (Ej: P006)"/>
                    <TextField fx:id="txtPeliTitulo" promptText="Título"/>
                    <TextField fx:id="txtPeliDuracion" promptText="Duración (minutos)"/>
                    <ComboBox fx:id="cmbPeliGenero" maxWidth="Infinity" promptText="Género"/>
                    <ComboBox fx:id="cmbPeliClasificacion" maxWidth="Infinity" promptText="Clasificación"/>
                    <TextArea fx:id="txtPeliSinopsis" prefHeight="75.0" promptText="Sinopsis" wrapText="true"/>
                    <CheckBox fx:id="chkPeliEnCartelera" selected="true" text="Disponible en Cartelera"/>
                    <Button maxWidth="Infinity" onAction="#onRegistrarPelicula"
                            styleClass="btn-primary" text="Guardar Película"/>
                </VBox>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Catálogo Registrado"/>
                    <TableView fx:id="tblAdminPeliculas" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAdmPeliCod" maxWidth="85.0" minWidth="70.0" text="Código"/>
                            <TableColumn fx:id="colAdmPeliTit" prefWidth="200.0" text="Título"/>
                            <TableColumn fx:id="colAdmPeliGen" prefWidth="110.0" text="Género"/>
                            <TableColumn fx:id="colAdmPeliClas" prefWidth="120.0" text="Clasificación"/>
                            <TableColumn fx:id="colAdmPeliDur" maxWidth="85.0" minWidth="70.0" text="Minutos"/>
                            <TableColumn fx:id="colAdmPeliActiva" maxWidth="95.0" minWidth="80.0" text="Cartelera"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Salas y Asientos">
            <HBox spacing="18.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>
                <VBox prefWidth="330.0" spacing="11.0" styleClass="card">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Registrar Sala"/>
                    <TextField fx:id="txtSalaNumero" promptText="Número de Sala"/>
                    <TextField fx:id="txtSalaFilas" promptText="Cantidad de Filas (1 - 26)"/>
                    <TextField fx:id="txtSalaAsientosPorFila" promptText="Asientos por Fila"/>
                    <ComboBox fx:id="cmbTipoAsientoDefecto" maxWidth="Infinity" promptText="Tipo de Asiento Base"/>
                    <Button maxWidth="Infinity" onAction="#onRegistrarSala"
                            styleClass="btn-primary" text="Crear Sala y Asientos"/>
                </VBox>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Salas Configuradas"/>
                    <TableView fx:id="tblAdminSalas" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAdmSalaNum" prefWidth="130.0" text="Sala"/>
                            <TableColumn fx:id="colAdmSalaCap" prefWidth="150.0" text="Capacidad"/>
                            <TableColumn fx:id="colAdmSalaAsientos" prefWidth="250.0" text="Asientos Generados"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Funciones y Cancelaciones">
            <HBox spacing="18.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>
                <VBox prefWidth="330.0" spacing="10.0" styleClass="card">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Programar Función"/>
                    <TextField fx:id="txtFuncionId" promptText="ID Función (Ej: F006)"/>
                    <ComboBox fx:id="cmbFuncionPelicula" maxWidth="Infinity" promptText="Película"/>
                    <ComboBox fx:id="cmbFuncionSala" maxWidth="Infinity" promptText="Sala"/>
                    <DatePicker fx:id="dpFuncionFecha" maxWidth="Infinity" promptText="Fecha"/>
                    <TextField fx:id="txtFuncionHora" promptText="Hora (HH:mm)"/>
                    <TextField fx:id="txtFuncionPrecioBase" promptText="Precio Base ($)"/>
                    <Button maxWidth="Infinity" onAction="#onRegistrarFuncion"
                            styleClass="btn-primary" text="Programar Función"/>
                </VBox>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Funciones Programadas"/>
                    <TableView fx:id="tblAdminFunciones" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAdmFuncId" maxWidth="80.0" minWidth="65.0" text="ID"/>
                            <TableColumn fx:id="colAdmFuncPeli" prefWidth="180.0" text="Película"/>
                            <TableColumn fx:id="colAdmFuncSala" maxWidth="70.0" minWidth="55.0" text="Sala"/>
                            <TableColumn fx:id="colAdmFuncFecha" prefWidth="140.0" text="Fecha y Hora"/>
                            <TableColumn fx:id="colAdmFuncOcup" prefWidth="90.0" text="Ocupación"/>
                            <TableColumn fx:id="colAdmFuncEstado" maxWidth="95.0" minWidth="80.0" text="Cancelada"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Label styleClass="text-muted" text="Reembolsa 100% y notifica a los compradores:"/>
                        <Button onAction="#onCancelarFuncionPorCine" styleClass="btn-danger"
                                text="Cancelar Función"/>
                    </HBox>
                </VBox>
            </HBox>
        </Tab>

    </TabPane>
</VBox>