<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainClienteBorderPane" prefHeight="760.0" prefWidth="1280.0" styleClass="app-canvas"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.poo.controller.ClienteDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar">
            <padding>
                <Insets bottom="12.0" left="24.0" right="24.0" top="12.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="2.0">
                <Label styleClass="cinema-title" text="Cinema"/>
                <Label style="-fx-text-fill: #E11D48; -fx-font-size: 18px; -fx-font-weight: bold;" text="UQ"/>
            </HBox>
            <Label styleClass="text-muted" text="·  Portal del Espectador"/>
            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="6.0" styleClass="pill-emerald">
                <Label style="-fx-text-fill: #6EE7B7; -fx-font-size: 11px;" text="SALDO:"/>
                <Label fx:id="lblSaldoTarjeta" style="-fx-text-fill: #34D399; -fx-font-weight: bold;" text="\$ 0"/>
            </HBox>

            <HBox alignment="CENTER" spacing="6.0" styleClass="pill-gold">
                <Label style="-fx-text-fill: #FDE68A; -fx-font-size: 11px;" text="PUNTOS:"/>
                <Label fx:id="lblPuntosCliente" style="-fx-text-fill: #FBBF24; -fx-font-weight: bold;" text="0 pts"/>
            </HBox>

            <Button fx:id="btnNotificaciones" onAction="#onAbrirNotificaciones" styleClass="btn-ghost" text="Notificaciones (0)"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblNombreCliente" styleClass="section-title" text="Cliente"/>
            <Button fx:id="btnCerrarSesion" onAction="#onCerrarSesion" styleClass="btn-danger" text="Salir"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220.0" spacing="6.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="14.0" right="14.0" top="20.0"/>
            </padding>
            <Label styleClass="kpi-label" text="NAVEGACIÓN">
                <padding><Insets bottom="6.0" left="10.0"/></padding>
            </Label>
            <Button fx:id="btnNavCartelera" maxWidth="Infinity" onAction="#onMostrarCartelera"
                    styleClass="nav-btn" text="Cartelera y Funciones"/>
            <Button fx:id="btnNavCompraConfiteria" maxWidth="Infinity" onAction="#onMostrarCompraConfiteria"
                    styleClass="nav-btn" text="Confitería y Combos"/>
            <Button fx:id="btnNavMonedero" maxWidth="Infinity" onAction="#onMostrarMonedero"
                    styleClass="nav-btn" text="Monedero y Puntos"/>
            <Button fx:id="btnNavHistorial" maxWidth="Infinity" onAction="#onMostrarHistorial"
                    styleClass="nav-btn" text="Historial y Avisos"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="4.0" styleClass="sub-panel">
                <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0"/></padding>
                <Label styleClass="brand-kicker" text="PROGRAMA LEALTAD"/>
                <Label styleClass="text-muted" wrapText="true"
                       text="Gana 10 puntos por cada entrada y redímelos en boletas o combos."/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="16.0" styleClass="app-canvas">
            <padding>
                <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0">
                    <Label styleClass="page-title" text="Cartelera en Exhibición"/>
                    <Label styleClass="text-muted" text="Selecciona una película para ver su sinopsis y horarios disponibles"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscarPelicula" prefWidth="220.0" promptText="Buscar por título o código..."/>
                <ComboBox fx:id="cmbFiltroGenero" prefWidth="150.0" promptText="Género"/>
                <ComboBox fx:id="cmbFiltroClasificacion" prefWidth="150.0" promptText="Clasificación"/>
                <Button onAction="#onFiltrarCartelera" styleClass="btn-primary" text="Filtrar"/>
                <Button onAction="#onLimpiarFiltros" styleClass="btn-ghost" text="Limpiar"/>
            </HBox>

            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Películas Disponibles"/>
                    <TableView fx:id="tblPeliculasCartelera" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colPeliCodigo" maxWidth="85.0" minWidth="70.0" text="Código"/>
                            <TableColumn fx:id="colPeliTitulo" prefWidth="210.0" text="Título"/>
                            <TableColumn fx:id="colPeliGenero" prefWidth="115.0" text="Género"/>
                            <TableColumn fx:id="colPeliClasificacion" prefWidth="125.0" text="Clasificación"/>
                            <TableColumn fx:id="colPeliDuracion" maxWidth="95.0" minWidth="75.0" text="Minutos"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox prefWidth="440.0" spacing="12.0" styleClass="card">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Sinopsis"/>
                    <TextArea fx:id="txtSinopsisPelicula" editable="false" prefHeight="85.0"
                              promptText="Selecciona una película de la lista..." wrapText="true"/>

                    <Label styleClass="section-title" text="Funciones Programadas"/>
                    <TableView fx:id="tblFuncionesPelicula" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colFuncId" maxWidth="75.0" minWidth="60.0" text="ID"/>
                            <TableColumn fx:id="colFuncFechaHora" prefWidth="145.0" text="Fecha y Hora"/>
                            <TableColumn fx:id="colFuncSala" prefWidth="85.0" text="Sala"/>
                            <TableColumn fx:id="colFuncPrecio" prefWidth="95.0" text="Precio"/>
                        </columns>
                    </TableView>

                    <Button fx:id="btnIrSeleccionAsientos" maxWidth="Infinity" onAction="#onSeleccionarAsientos"
                            styleClass="btn-primary" text="Seleccionar Asientos"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>