<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainClienteBorderPane" prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #0D0D0D; -fx-font-family: 'Georgia';"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.poo.controller.ClienteDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #362822; -fx-border-color: #C28D39; -fx-border-width: 0 0 1.5 0;">
            <padding>
                <Insets bottom="12.0" left="25.0" right="25.0" top="12.0"/>
            </padding>
            <Label style="-fx-text-fill: #C28D39; -fx-font-size: 26px; -fx-font-weight: bold;" text="CinemaUQ"/>
            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #0D0D0D; -fx-border-color: #C28D39; -fx-border-radius: 6; -fx-background-radius: 6;">
                <padding>
                    <Insets bottom="6.0" left="14.0" right="14.0" top="6.0"/>
                </padding>
                <Label style="-fx-text-fill: #EFE5D2; -fx-font-size: 12px;" text="Saldo Tarjeta Virtual:"/>
                <Label fx:id="lblSaldoTarjeta" style="-fx-text-fill: #C28D39; -fx-font-size: 15px; -fx-font-weight: bold;" text="\$ 0.00"/>
            </HBox>

            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #0D0D0D; -fx-border-color: #C28D39; -fx-border-radius: 6; -fx-background-radius: 6;">
                <padding>
                    <Insets bottom="6.0" left="14.0" right="14.0" top="6.0"/>
                </padding>
                <Label style="-fx-text-fill: #EFE5D2; -fx-font-size: 12px;" text="Puntos Disponibles:"/>
                <Label fx:id="lblPuntosCliente" style="-fx-text-fill: #C28D39; -fx-font-size: 15px; -fx-font-weight: bold;" text="0 pts"/>
            </HBox>

            <Button fx:id="btnNotificaciones" onAction="#onAbrirNotificaciones"
                    style="-fx-background-color: #0D0D0D; -fx-text-fill: #EFE5D2; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 7 14; -fx-cursor: hand;"
                    text="Notificaciones (0)"/>
            <Label fx:id="lblNombreCliente" style="-fx-text-fill: #EFE5D2; -fx-font-weight: bold;" text="Cliente"/>
            <Button fx:id="btnCerrarSesion" onAction="#onCerrarSesion"
                    style="-fx-background-color: #710912; -fx-text-fill: #EFE5D2; -fx-font-weight: bold; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 7 16; -fx-cursor: hand;"
                    text="Cerrar Sesion"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #362822; -fx-border-color: #C28D39; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20.0" left="14.0" right="14.0" top="25.0"/>
            </padding>
            <Label style="-fx-text-fill: #C28D39; -fx-font-size: 13px; -fx-font-weight: bold;" text="MENU DE NAVEGACION"/>
            <Button fx:id="btnNavCartelera" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onMostrarCartelera"
                    style="-fx-background-color: #710912; -fx-text-fill: #EFE5D2; -fx-font-weight: bold; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10 15; -fx-cursor: hand;"
                    text="Cartelera y Funciones"/>
            <Button fx:id="btnNavCompraConfiteria" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onMostrarCompraConfiteria"
                    style="-fx-background-color: #0D0D0D; -fx-text-fill: #EFE5D2; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10 15; -fx-cursor: hand;"
                    text="Compra Confiteria y Combos"/>
            <Button fx:id="btnNavMonedero" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onMostrarMonedero"
                    style="-fx-background-color: #0D0D0D; -fx-text-fill: #EFE5D2; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10 15; -fx-cursor: hand;"
                    text="Mi Tarjeta y Puntos"/>
            <Button fx:id="btnNavHistorial" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onMostrarHistorial"
                    style="-fx-background-color: #0D0D0D; -fx-text-fill: #EFE5D2; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10 15; -fx-cursor: hand;"
                    text="Mis Compras y Reembolsos"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0" style="-fx-background-color: #0D0D0D;">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #362822; -fx-border-color: #C28D39; -fx-border-radius: 8; -fx-background-radius: 8;">
                <padding>
                    <Insets bottom="12.0" left="18.0" right="18.0" top="12.0"/>
                </padding>
                <Label style="-fx-text-fill: #C28D39; -fx-font-size: 15px; -fx-font-weight: bold;" text="Consultar Cartelera:"/>
                <TextField fx:id="txtBuscarPelicula" prefWidth="230.0" promptText="Titulo o codigo..." style="-fx-background-color: #0D0D0D; -fx-text-fill: #EFE5D2; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-padding: 6;"/>
                <ComboBox fx:id="cmbFiltroGenero" prefWidth="170.0" promptText="Genero" style="-fx-background-color: #0D0D0D; -fx-border-color: #C28D39; -fx-border-radius: 5;"/>
                <ComboBox fx:id="cmbFiltroClasificacion" prefWidth="180.0" promptText="Clasificacion" style="-fx-background-color: #0D0D0D; -fx-border-color: #C28D39; -fx-border-radius: 5;"/>
                <Button onAction="#onFiltrarCartelera" style="-fx-background-color: #710912; -fx-text-fill: #EFE5D2; -fx-font-weight: bold; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-padding: 6 16;" text="Filtrar"/>
                <Button onAction="#onLimpiarFiltros" style="-fx-background-color: #0D0D0D; -fx-text-fill: #EFE5D2; -fx-border-color: #C28D39; -fx-border-radius: 5; -fx-padding: 6 16;" text="Limpiar"/>
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                <VBox spacing="10.0" style="-fx-background-color: #362822; -fx-border-color: #C28D39; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                    <Label style="-fx-text-fill: #C28D39; -fx-font-size: 16px; -fx-font-weight: bold;" text="Peliculas en Cartelera"/>
                    <TableView fx:id="tblPeliculasCartelera" style="-fx-background-color: #0D0D0D; -fx-border-color: #C28D39;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPeliCodigo" prefWidth="80.0" text="Codigo"/>
                            <TableColumn fx:id="colPeliTitulo" prefWidth="200.0" text="Titulo"/>
                            <TableColumn fx:id="colPeliGenero" prefWidth="110.0" text="Genero"/>
                            <TableColumn fx:id="colPeliClasificacion" prefWidth="120.0" text="Clasificacion"/>
                            <TableColumn fx:id="colPeliDuracion" prefWidth="90.0" text="Duracion (min)"/>
                        </columns>
                    </TableView>
                    <Label style="-fx-text-fill: #EFE5D2; -fx-font-size: 12px;" text="Sinopsis de la pelicula seleccionada:"/>
                    <TextArea fx:id="txtSinopsisPelicula" editable="false" prefHeight="75.0" style="-fx-control-inner-background: #0D0D0D; -fx-text-fill: #EFE5D2; -fx-border-color: #C28D39;" wrapText="true"/>
                </VBox>

                <VBox prefWidth="440.0" spacing="12.0" style="-fx-background-color: #362822; -fx-border-color: #C28D39; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                    <Label style="-fx-text-fill: #C28D39; -fx-font-size: 16px; -fx-font-weight: bold;" text="Funciones Programadas"/>
                    <TableView fx:id="tblFuncionesPelicula" style="-fx-background-color: #0D0D0D; -fx-border-color: #C28D39;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFuncId" prefWidth="70.0" text="ID"/>
                            <TableColumn fx:id="colFuncFechaHora" prefWidth="150.0" text="Fecha y Hora"/>
                            <TableColumn fx:id="colFuncSala" prefWidth="75.0" text="Sala"/>
                            <TableColumn fx:id="colFuncPrecio" prefWidth="110.0" text="Precio Base"/>
                        </columns>
                    </TableView>
                    <Button fx:id="btnIrSeleccionAsientos" maxWidth="Infinity" onAction="#onSeleccionarAsientos"
                            style="-fx-background-color: #C28D39; -fx-text-fill: #0D0D0D; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-cursor: hand;"
                            text="SELECCIONAR ASIENTOS Y COMPRAR"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>