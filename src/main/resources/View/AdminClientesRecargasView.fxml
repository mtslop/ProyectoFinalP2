<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="1060.0" spacing="16.0" styleClass="app-canvas"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.controller.AdminClientesRecargasController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
    </padding>

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Recargas, Clientes y Compras"/>
        <Label styleClass="text-muted" text="Aprueba solicitudes de saldo, recarga tarjetas directamente y asigna planes VIP de puntos"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Recargas de Tarjeta Virtual">
            <VBox spacing="14.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/></padding>
                    <Label styleClass="section-title" text="Recarga Directa:"/>
                    <TextField fx:id="txtAdminCorreoClienteRecarga" prefWidth="250.0" promptText="Correo o ID del cliente"/>
                    <TextField fx:id="txtAdminMontoRecargaDirecta" prefWidth="160.0" promptText="Monto ($)"/>
                    <Button onAction="#onRecargarTarjetaDirecto" styleClass="btn-gold" text="Recargar Ahora"/>
                </HBox>

                <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Solicitudes Pendientes y Atendidas"/>
                    <TableView fx:id="tblSolicitudesRecargaAdmin" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAdmSolId" prefWidth="95.0" text="ID"/>
                            <TableColumn fx:id="colAdmSolCliente" prefWidth="230.0" text="Cliente"/>
                            <TableColumn fx:id="colAdmSolTarjeta" prefWidth="150.0" text="Tarjeta"/>
                            <TableColumn fx:id="colAdmSolMonto" prefWidth="120.0" text="Monto"/>
                            <TableColumn fx:id="colAdmSolFecha" prefWidth="145.0" text="Fecha"/>
                            <TableColumn fx:id="colAdmSolEstado" prefWidth="120.0" text="Estado"/>
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button onAction="#onRechazarSolicitudRecarga" styleClass="btn-danger" text="Rechazar"/>
                        <Button onAction="#onAprobarSolicitudRecarga" styleClass="btn-gold" text="Aprobar y Recargar"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>

        <Tab text="Clientes y Compras Globales">
            <HBox spacing="18.0">
                <padding><Insets bottom="6.0" left="2.0" right="2.0" top="14.0"/></padding>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Clientes Registrados"/>
                    <TableView fx:id="tblAdminClientes" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAdmCliId" maxWidth="85.0" minWidth="65.0" text="ID"/>
                            <TableColumn fx:id="colAdmCliNombre" prefWidth="145.0" text="Nombre"/>
                            <TableColumn fx:id="colAdmCliCorreo" prefWidth="150.0" text="Correo"/>
                            <TableColumn fx:id="colAdmCliSaldo" prefWidth="100.0" text="Saldo"/>
                            <TableColumn fx:id="colAdmCliPuntos" maxWidth="80.0" minWidth="65.0" text="Puntos"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ComboBox fx:id="cmbEstrategiaCliente" maxWidth="Infinity" promptText="Estrategia de Puntos" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#onActualizarEstrategiaCliente" styleClass="btn-primary" text="Asignar"/>
                    </HBox>
                </VBox>

                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label styleClass="section-title" text="Compras Registradas"/>
                    <TableView fx:id="tblAdminComprasGlobal" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAdmCmpId" maxWidth="85.0" minWidth="70.0" text="ID"/>
                            <TableColumn fx:id="colAdmCmpCliente" prefWidth="130.0" text="Cliente"/>
                            <TableColumn fx:id="colAdmCmpFuncion" prefWidth="150.0" text="Función"/>
                            <TableColumn fx:id="colAdmCmpTotal" prefWidth="95.0" text="Total"/>
                            <TableColumn fx:id="colAdmCmpEstado" prefWidth="105.0" text="Estado"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </Tab>

    </TabPane>
</VBox>