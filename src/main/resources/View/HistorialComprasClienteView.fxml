<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="680.0" prefWidth="1040.0" spacing="16.0" styleClass="app-canvas"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.controller.HistorialComprasClienteController">
    <padding>
        <Insets bottom="22.0" left="24.0" right="24.0" top="20.0"/>
    </padding>

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Historial de Compras y Notificaciones"/>
        <Label styleClass="text-muted" text="Gestiona cancelaciones con reembolso automático y revisa alertas de tus funciones"/>
    </VBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
            <Label styleClass="section-title" text="Mis Compras Realizadas"/>
            <TableView fx:id="tblHistorialCompras" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colHistId" prefWidth="85.0" text="ID"/>
                    <TableColumn fx:id="colHistFecha" prefWidth="130.0" text="Fecha"/>
                    <TableColumn fx:id="colHistFuncion" prefWidth="180.0" text="Película / Función"/>
                    <TableColumn fx:id="colHistTotal" prefWidth="100.0" text="Total"/>
                    <TableColumn fx:id="colHistEstado" prefWidth="105.0" text="Estado"/>
                    <TableColumn fx:id="colHistReembolso" prefWidth="115.0" text="Reembolso"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="sub-panel">
                <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0"/></padding>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="brand-kicker" text="POLÍTICA DE REEMBOLSO"/>
                    <Label styleClass="text-muted" text="+24h: 100%  ·  Entre 2h y 24h: 80%  ·  Menos de 2h: No permitida"/>
                </VBox>
                <Button fx:id="btnCancelarCompraCliente" onAction="#onSolicitarCancelacionCompra"
                        styleClass="btn-danger" text="Cancelar Compra"/>
            </HBox>
        </VBox>

        <VBox prefWidth="330.0" spacing="10.0" styleClass="card">
            <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
            <Label styleClass="section-title" text="Centro de Notificaciones"/>
            <Label styleClass="text-muted" text="Alertas en tiempo real sobre funciones suscritas:"/>
            <ListView fx:id="lstNotificacionesCliente" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>